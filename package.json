{
  "name": "algolens",
  "private": true,
  "version": "0.14.0-t1",
  "type": "module",
  "license": "MIT",
  "description": "AlgoViz - interactive data structure and algorithm visualization learning platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "sync:legacy": "node scripts/sync-legacy-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "pack:build": "node scripts/build-pack.mjs",
    "pack": "vite-node scripts/validate-pack.ts --",
    "mcp:build": "node packages/mcp-server/scripts/build.mjs",
    "mcp:start": "node packages/mcp-server/dist/server.mjs",
    "mcp:typecheck": "tsc -p packages/mcp-server/tsconfig.json --noEmit --pretty false",
    "mcp:smoke": "node packages/mcp-server/scripts/smoke.mjs",
    "mcp:install": "npm install --prefix packages/mcp-server",
    "ai:build": "node packages/ai-gateway/scripts/build.mjs",
    "ai:start": "node --env-file-if-exists=.env packages/ai-gateway/dist/server.mjs",
    "ai:dev": "node --env-file-if-exists=.env node_modules/vite-node/vite-node.mjs packages/ai-gateway/src/main.ts",
    "ai:typecheck": "tsc -p packages/ai-gateway/tsconfig.json --noEmit --pretty false",
    "ai:install": "npm install --prefix packages/ai-gateway"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "monaco-editor": "^0.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "pyodide": "^0.27.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
