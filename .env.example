# AlgoLens local AI Gateway — copy to `.env` (never commit `.env`).
# The Gateway reads process environment only; the web page never sees these keys.

# Bind address is fixed to 127.0.0.1. Port only:
ALGOLENS_AI_PORT=8787

# Extra allowed browser origins (comma separated). Defaults already include
# http://localhost:5173, http://127.0.0.1:5173, http://localhost:4173, http://127.0.0.1:4173.
# ALGOLENS_AI_ORIGINS=

# Request limits
# ALGOLENS_AI_MAX_BODY_BYTES=98304
# ALGOLENS_AI_TIMEOUT_MS=30000
# ALGOLENS_AI_RATE_LIMIT=20

# --- Local Ollama (recommended, no cloud key) ---
# Must be a loopback URL.
ALGOLENS_OLLAMA_URL=http://127.0.0.1:11434
ALGOLENS_OLLAMA_MODEL=llama3.2
# ALGOLENS_OLLAMA_TIMEOUT_MS=20000

# --- Optional cloud provider: OpenAI Chat Completions only ---
# Leave empty to keep the cloud provider disabled.
ALGOLENS_OPENAI_API_KEY=
ALGOLENS_OPENAI_BASE_URL=https://api.openai.com/v1
ALGOLENS_OPENAI_MODEL=gpt-4o-mini

# --- Test / E2E only ---
# Registers a deterministic provider. Never use this for a real lesson.
# ALGOLENS_AI_MOCK=1
